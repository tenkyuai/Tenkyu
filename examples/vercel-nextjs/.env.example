# Server-only. Never prefix with NEXT_PUBLIC_.
TENKYU_API_KEY=tk_test_replace_me
SIGNUP_CREDITS=100
# Optional
# FAIL_OPEN_CREDIT_FRACTION=0.25
# TENKYU_TIMEOUT_MS=1500
# TENKYU_BASE_URL=https://api.tenkyu.dev
# Only if you use lib/supabase-auth.ts (server only, the service-role key bypasses row-level security)
