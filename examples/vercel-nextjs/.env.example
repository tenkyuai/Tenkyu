# SUPABASE_ANON_KEY=...
# SUPABASE_SERVICE_ROLE_KEY=...
# Set to 1 only to run in production WITHOUT Next after() (duplicate-email timing padding is then approximate)
# TENKYU_ALLOW_INLINE_SCORING=1
