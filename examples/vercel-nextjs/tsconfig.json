{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "types": [],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "paths": {
      // Resolves to the local client so the example type-checks inside this repo. In your own project:
      // `npm install tenkyu` and delete this "paths" block.
      "tenkyu": ["../../clients/js/src/index.ts"]
    }
  },
  "include": ["middleware.ts", "app", "lib", "types"]
}
